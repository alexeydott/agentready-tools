{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentready.dev/schemas/agentready.audit.v2.schema.json",
  "title": "AgentReady audit v2 contract",
  "type": "object",
  "required": ["schema", "target", "version", "coverage", "evidence", "findings", "score"],
  "properties": {
    "schema": {
      "const": "agentready.audit.v2"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "properties": {
          "id": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["total_rules", "evaluated_rules", "applicable_rules", "complete_rules"],
      "additionalProperties": false,
      "properties": {
        "total_rules": {"type": "integer", "minimum": 0},
        "evaluated_rules": {"type": "integer", "minimum": 0},
        "applicable_rules": {"type": "integer", "minimum": 0},
        "complete_rules": {"type": "integer", "minimum": 0},
        "urls_discovered": {"type": "integer", "minimum": 0},
        "urls_fetched": {"type": "integer", "minimum": 0},
        "classification": {"type": "string"},
        "limit": {
          "type": "object",
          "required": ["max_pages_hit"],
          "additionalProperties": false,
          "properties": {
            "max_pages_hit": {"type": "boolean"}
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "reason", "fingerprint", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"enum": ["pass", "fail", "warn", "skip", "unavailable"]},
          "reason": {"type": "string"},
          "rule_version": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["pass", "fail", "warn", "unknown", "not_applicable"]},
          "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
          "completeness": {"enum": ["complete", "partial", "not_evaluated"]},
          "operational_state": {"enum": ["none", "unavailable", "error"]},
          "fingerprint": {"type": "string"},
          "state_hash": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "summary"],
              "properties": {
                "id": {"type": "string"},
                "summary": {"type": "string"},
                "url": {"type": "string", "format": "uri"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
