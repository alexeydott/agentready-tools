{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentready.dev/schemas/agentready.audit.v2.schema.json",
  "title": "AgentReady audit v2 contract",
  "type": "object",
  "required": ["schema", "target", "version", "coverage", "evidence", "findings"],
  "properties": {
    "schema": {
      "const": "agentready.audit.v2"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "properties": {
          "id": {"type": "string"},
          "summary": {"type": "string"},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["total_rules", "evaluated_rules", "applicable_rules", "complete_rules"],
      "additionalProperties": false,
      "properties": {
        "total_rules": {"type": "integer", "minimum": 0},
        "evaluated_rules": {"type": "integer", "minimum": 0},
        "applicable_rules": {"type": "integer", "minimum": 0},
        "complete_rules": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "reason", "fingerprint", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"enum": ["pass", "fail", "warn", "skip", "unavailable"]},
          "reason": {"type": "string"},
          "fingerprint": {"type": "string"},
          "evidence": {"type": "array"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
