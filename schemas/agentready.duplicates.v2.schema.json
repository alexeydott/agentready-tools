{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentready.duplicates.v2",
  "type": "object",
  "required": ["run_id", "algorithm_version", "threshold", "items", "next_cursor", "total"],
  "properties": {
    "run_id": {"type": "string"},
    "algorithm_version": {"type": "string"},
    "threshold": {"type": "integer", "minimum": 0, "maximum": 64},
    "fingerprint": {"type": "string"},
    "candidate_comparisons": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "maxItems": 1000, "items": {"type": "object", "required": ["cluster_id", "near_duplicate", "members"], "properties": {"cluster_id": {"type": "string"}, "near_duplicate": {"type": "boolean"}, "members": {"type": "array", "items": {"type": "object", "required": ["url", "kind", "similarity", "exact_hash"], "properties": {"url": {"type": "string", "format": "uri"}, "kind": {"enum": ["exact", "near"]}, "similarity": {"type": "number", "minimum": 0, "maximum": 1}, "exact_hash": {"type": "string"}}}}}}},
    "next_cursor": {"type": ["string", "null"]},
    "total": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
